# Base URL of the Medora API Gateway. All requests are routed through
# the gateway (JWT validation, rate limiting, correlation IDs). Do NOT point
# this at individual microservice ports directly.
NEXT_PUBLIC_API_BASE_URL="http://localhost:8080"

# Request timeout for the HTTP client, in milliseconds.
NEXT_PUBLIC_API_TIMEOUT_MS="15000"

# Display name used across the header, landing page, and email/browser titles.
NEXT_PUBLIC_APP_NAME="Medora"
