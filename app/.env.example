# Local development default. To use a remote backend, replace this with the
# HTTPS origin of your hosted API Gateway BEFORE building the frontend.
# Example only: https://api.your-domain.example (do not use this placeholder).
# Do not point this at an individual service and do not append /api.
NEXT_PUBLIC_API_BASE_URL="http://localhost:8080"
NEXT_PUBLIC_API_TIMEOUT_MS="15000"
NEXT_PUBLIC_APP_NAME="Medora"

# NEXT_PUBLIC_* values are visible in browser JavaScript. Never put JWT signing
# keys, service tokens, database credentials, or SMTP passwords here.
